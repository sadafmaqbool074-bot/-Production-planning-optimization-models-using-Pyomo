        "model=pyo.ConcreteModel()\n",
        "#Sets\n",
        "model.P=pyo.Set(initialize=P[\"Product\"].tolist())\n",
        "model.M=pyo.Set(initialize=[\"Jan\",\"Feb\",\"Mar\"])\n",
        "\n",
        "#Paramaeters\n",
        "model.Production_Cost=pyo.Param(model.P,initialize=P.set_index(\"Product\")[\"Production Cost\"].to_dict())\n",
        "model.Machine_Hours=pyo.Param(model.P,initialize=P.set_index(\"Product\")[\"Machine Hours\"].to_dict())\n",
        "model.Holding_Cost=pyo.Param(model.P,initialize=P.set_index(\"Product\")[\"Holding Cost\"].to_dict())\n",
        "model.Backlog_Cost =pyo.Param(model.P,initialize=P.set_index(\"Product\")[\"Backlog Cost\"].to_dict())\n",
        "model.Jan_Demand  =pyo.Param(model.P,initialize=P.set_index(\"Product\")[\"Jan Demand\"].to_dict())\n",
        "model.Feb_Demand  =pyo.Param(model.P,initialize=P.set_index(\"Product\")[\"Feb Demand\"].to_dict())\n",
        "model.Mar_Demand  =pyo.Param(model.P,initialize=P.set_index(\"Product\")[\"Mar Demand\"].to_dict())\n",
        "\n",
        "\n",
        "#Decision Variable here we have three main decisions ptoduction,inventory,backlog we neeed to decide for each them we can minimize our objective\n",
        "\n",
        "\n",
        "model.x=pyo.Var(model.P,model.M,within=pyo.NonNegativeIntegers)\n",
        "model.I=pyo.Var(model.P,model.M,within=pyo.NonNegativeIntegers)\n",
        "model.B=pyo.Var(model.P,model.M,within=pyo.NonNegativeIntegers)\n",
        "\n",
        "#Constraints\n",
        "def Machine_Capacity_rule(model):\n",
        "    return sum(\n",
        "        model.x[p, \"Jan\"] * model.Machine_Hours[p]\n",
        "        for p in model.P\n",
        "    ) <= 300\n",
        "\n",
        "model.JanCapacity = pyo.Constraint(rule=Machine_Capacity_rule)\n",
        "\n",
        "def Machine_Capacity_rule(model):\n",
        "    return sum(\n",
        "        model.x[p, \"Feb\"] * model.Machine_Hours[p]\n",
        "        for p in model.P\n",
        "    ) <= 350\n",
        "\n",
        "model.FebCapacity = pyo.Constraint(rule=Machine_Capacity_rule)\n",
        "def Machine_Capacity_rule(model):\n",
        "    return sum(\n",
        "        model.x[p, \"Mar\"] * model.Machine_Hours[p]\n",
        "        for p in model.P\n",
        "    ) <= 400\n",
        "\n",
        "model.MarCapacity = pyo.Constraint(rule=Machine_Capacity_rule)\n",
        "def Jan_balance_rule(model, p):\n",
        "\n",
        "    return (\n",
        "        model.x[p, \"Jan\"]\n",
        "        - model.Jan_Demand[p]\n",
        "        == model.I[p, \"Jan\"]\n",
        "        - model.B[p, \"Jan\"]\n",
        "    )\n",
        "\n",
        "model.Jan_balance = pyo.Constraint(\n",
        "    model.P,\n",
        "    rule=Jan_balance_rule\n",
        ")\n",
        "def Feb_balance_rule(model, p):\n",
        "    return (\n",
        "        model.x[p, \"Feb\"]\n",
        "        - model.Jan_Demand[p]\n",
        "        == model.I[p, \"Feb\"]\n",
        "        - model.B[p, \"Feb\"]\n",
        "    )\n",
        "\n",
        "model.Feb_balance = pyo.Constraint(\n",
        "    model.P,\n",
        "    rule=Feb_balance_rule\n",
        "\n",
        ")\n",
        "\n",
        "def Mar_balance_rule(model, p):\n",
        "    return (\n",
        "        model.x[p, \"Mar\"]\n",
        "        - model.Mar_Demand[p]\n",
        "        == model.I[p, \"Mar\"]\n",
        "        - model.B[p, \"Mar\"]\n",
        "    )\n",
        "\n",
        "model.Mar_balance = pyo.Constraint(\n",
        "    model.P,\n",
        "    rule=Mar_balance_rule\n",
        ")\n",
        "\n",
        "def Total_Cost_rule(model):\n",
        "\n",
        "    return sum(\n",
        "        model.Production_Cost[p] * model.x[p, m]\n",
        "        + model.Holding_Cost[p] * model.I[p, m]\n",
        "        + model.Backlog_Cost[p] * model.B[p, m]\n",
        "        for p in model.P\n",
        "        for m in model.M\n",
        "    )\n",
        "\n",
        "model.Total_Cost = pyo.Objective(\n",
        "    rule=Total_Cost_rule,\n",
        "    sense=pyo.minimize\n",
        ")\n",
        "from pyomo.environ import SolverFactory\n",
        "\n",
        "solver = SolverFactory(\"glpk\")\n",
        "results=solver.solve(model)\n",
        "print(\"Optimal Cost:\",(pyo.value(model.Total_Cost)))\n",
        "print(results.solver.termination_condition)\n",
        "print(results.solver.status)\n"
      ],
