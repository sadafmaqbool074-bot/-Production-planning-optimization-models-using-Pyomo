        "        for p in model.P\n",
        "    )\n",
        "\n",
        "    if m == \"Jan\":\n",
        "        capacity = 300\n",
        "    elif m == \"Feb\":\n",
        "        capacity = 350\n",
        "    elif m == \"Mar\":\n",
        "        capacity = 400\n",
        "\n",
        "    utilization = (machine_hours_used / capacity) * 100\n",
        "\n",
        "    results_table.append({\n",
        "        \"Month\": m,\n",
        "        \"Hours Used\": round(machine_hours_used, 2),\n",
        "        \"Capacity\": capacity,\n",
        "        \"Unused\": round(capacity - machine_hours_used, 2),\n",
        "        \"Utilization (%)\": round(utilization, 2)\n",
        "    })\n",
        "\n",
        "results_df = pd.DataFrame(results_table)\n",
        "\n",
